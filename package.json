{
  "name": "hive",
  "productName": "Hive",
  "version": "2.0.0",
  "description": "Work with many Claude Code sessions at once",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dist": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dist.ts",
    "dist:release": "electron-vite build && electron-builder",
    "test": "tsx --test src/main/*.test.ts src/renderer/*.test.ts scripts/*.test.ts",
    "screenshots": "npm run build && tsx e2e/screenshots.ts",
    "test:e2e": "npm run build && tsx --test --test-concurrency=1 e2e/*.e2e.ts",
    "prepare": "husky",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const d=p.join('node_modules','node-pty','prebuilds');if(fs.existsSync(d))for(const f of fs.readdirSync(d)){const h=p.join(d,f,'spawn-helper');if(fs.existsSync(h))fs.chmodSync(h,0o755)}\"",
    "dev:watch": "electron-vite dev --watch",
    "predev": "node scripts/brand-electron.cjs",
    "predev:watch": "node scripts/brand-electron.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.calielc.hive",
    "productName": "Hive",
    "artifactName": "Hive-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "afterPack": "scripts/ad-hoc-sign.cjs",
    "files": [
      "out/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
