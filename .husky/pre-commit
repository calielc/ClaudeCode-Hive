# Checks the staged files before each commit. It only checks and never changes a file.
# `git commit --no-verify` skips it. The CI runs the same lint on every pull request.
npx --no-install biome check --staged --no-errors-on-unmatched || {
  echo "" >&2
  echo "The lint found problems in the staged files. Run npm run lint:fix, stage the files again and commit again." >&2
  exit 1
}
